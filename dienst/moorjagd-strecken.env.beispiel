# Vorlage für /etc/default/moorjagd-strecken (wird von moorjagd-strecken.service gelesen)

# Adresse und Port, auf denen der Dienst lauscht
MOORJAGD_ADRESSE=127.0.0.1
MOORJAGD_PORT=8097

# Nur Anfragen von dieser Adresse (dem Reverse-Proxy) werden angenommen,
# sonst ließe sich X-Forwarded-For fälschen
MOORJAGD_VERTRAUT=127.0.0.1

# Origin der Seite, kommagetrennt; andere Origins werden abgewiesen
MOORJAGD_HERKUNFT=https://spiel.example.org

# Mindestalter einer Rundenmarke in Sekunden, bevor ein Eintrag angenommen wird (Runde = 90 s)
#MOORJAGD_MINDESTDAUER=85

# Rundendauer im Mehrspieler in Sekunden (kürzer nur zum Testen)
#MOORJAGD_RUNDE=90
